/* ==========================================================================
   LogWaver - feuille de style principale
   Le style visuel est entièrement défini ici ; le code Python ne fait que
   poser des objectName et des propriétés dynamiques (role, state...).
   ========================================================================== */

QWidget {
    font-size: 10pt;
    color: #1f2933;
}

QMainWindow, QDialog {
    background-color: #f4f6f8;
}

QGroupBox {
    border: 1px solid #d5dbe1;
    border-radius: 6px;
    margin-top: 12px;
    padding: 8px;
    background-color: #ffffff;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #2f4f6f;
}

QLabel#PanelTitle {
    font-size: 12pt;
    font-weight: bold;
    color: #2f4f6f;
    padding: 4px 0;
}

QLabel#HintLabel, QLabel#MetaLabel, QLabel#CountLabel {
    color: #5f6b76;
    font-style: italic;
    font-weight: normal;
}

QLabel#StatusBadge {
    border-radius: 4px;
    padding: 4px 8px;
    font-weight: bold;
    color: #ffffff;
    background-color: #9aa5b1;
}

QLabel#TestStatus[state="ok"] { color: #2e7d32; font-weight: bold; }
QLabel#TestStatus[state="warning"] { color: #b26a00; font-weight: bold; }
QLabel#TestStatus[state="error"] { color: #c62828; font-weight: bold; }

QPushButton {
    background-color: #ffffff;
    border: 1px solid #b8c2cc;
    border-radius: 4px;
    padding: 5px 12px;
}

QPushButton:hover { background-color: #e8eef4; }
QPushButton:pressed { background-color: #d5dee8; }
QPushButton:disabled { color: #a0aab4; border-color: #dde3e8; }

QPushButton[role="primary"] {
    background-color: #2f6fb0;
    border-color: #2a5f96;
    color: #ffffff;
    font-weight: bold;
}

QPushButton[role="primary"]:hover { background-color: #3a7fc4; }
QPushButton[role="primary"]:disabled { background-color: #9fb9d4; color: #eef3f8; }

QLineEdit, QComboBox, QPlainTextEdit, QTableWidget, QListWidget {
    background-color: #ffffff;
    border: 1px solid #c9d1d9;
    border-radius: 4px;
    padding: 3px;
    selection-background-color: #2f6fb0;
    selection-color: #ffffff;
}

QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus {
    border-color: #2f6fb0;
}

QTableView#EntryTable {
    background-color: #ffffff;
    alternate-background-color: #f7f9fb;
    gridline-color: #e3e8ed;
    border: 1px solid #c9d1d9;
    selection-background-color: #cfe1f5;
    selection-color: #1f2933;
}

QHeaderView::section {
    background-color: #2f4f6f;
    color: #ffffff;
    padding: 5px;
    border: none;
    border-right: 1px solid #3f6283;
    font-weight: bold;
}

QListWidget#CategoryList::item {
    padding: 7px 4px;
    border-bottom: 1px solid #eef1f4;
}

QListWidget#CategoryList::item:selected {
    background-color: #2f6fb0;
    color: #ffffff;
}

QPlainTextEdit#RawLogLine, QPlainTextEdit#PromptText, QPlainTextEdit#CodeViewer {
    font-family: "Consolas", "DejaVu Sans Mono", monospace;
    background-color: #fbfcfd;
}

QToolBar#MainToolbar {
    background-color: #e9edf1;
    border-bottom: 1px solid #d5dbe1;
    spacing: 4px;
    padding: 3px;
}

QStatusBar {
    background-color: #e9edf1;
    color: #3e4c59;
}

QSplitter::handle {
    background-color: #dfe4e9;
}

QSplitter::handle:horizontal { width: 4px; }
QSplitter::handle:vertical { height: 4px; }

/* --------------------------------------------------------------------------
   Prise en main : accueil, bandeau « À faire », didacticiel
   -------------------------------------------------------------------------- */

QLabel#WelcomeTitle {
    font-size: 24pt;
    font-weight: bold;
    color: #2f4f6f;
}

QLabel#WelcomeSubtitle {
    font-size: 12pt;
    color: #5f6b76;
}

QFrame#StepCard {
    background-color: #ffffff;
    border: 1px solid #d5dbe1;
    border-radius: 10px;
    padding: 12px;
    min-width: 220px;
    max-width: 320px;
}

QLabel#StepNumber {
    background-color: #2f6fb0;
    color: #ffffff;
    border-radius: 16px;
    min-width: 32px;
    min-height: 32px;
    max-width: 32px;
    max-height: 32px;
    font-size: 13pt;
    font-weight: bold;
}

QLabel#StepHeading {
    font-size: 12pt;
    font-weight: bold;
}

QPushButton[role="hero"] {
    background-color: #2e9d4f;
    border-color: #26843f;
    color: #ffffff;
    font-size: 11pt;
    font-weight: bold;
    padding: 9px 18px;
}

QPushButton[role="hero"]:hover { background-color: #36b35b; }
QPushButton[role="hero"]:disabled { background-color: #a9d4b6; color: #f0f7f2; }

QPushButton[role="link"] {
    background: transparent;
    border: none;
    color: #2f6fb0;
    text-decoration: underline;
}

QLabel#GuideBanner {
    background-color: #fff8e1;
    border: 1px solid #f0d58c;
    border-radius: 6px;
    padding: 8px 10px;
    color: #4a3b00;
}

QLineEdit#SearchEdit {
    padding: 6px;
    font-size: 10.5pt;
}

QTreeView#EntryTree {
    background-color: #ffffff;
    alternate-background-color: #f7f9fb;
    border: 1px solid #c9d1d9;
    selection-background-color: #cfe1f5;
    selection-color: #1f2933;
}

QTreeView#EntryTree::item {
    padding: 3px 0;
}

QDockWidget#TutorialPanel::title {
    background-color: #2f4f6f;
    color: #ffffff;
    padding: 6px;
}

QWidget#TutorialContent {
    background-color: #ffffff;
}

QLabel#TutorialTitle {
    font-size: 14pt;
    font-weight: bold;
    color: #2f4f6f;
}

QLabel#TutorialText {
    font-size: 10.5pt;
    line-height: 140%;
}

/* Widget mis en évidence par le didacticiel */
*[tutorialTarget="true"] {
    border: 3px solid #f39c12;
    border-radius: 6px;
}

QWidget#CategoryPanel {
    min-width: 210px;
}

QWidget#MatchingKeysContent {
    background-color: #ffffff;
}
